*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#4f88a3;
}

.container{
display:flex;
height:100vh;
}

/* Sidebar */
.sidebar{
width:80px;
background:#2f6c84;
display:flex;
flex-direction:column;
align-items:center;
padding:20px 0;
gap:25px;
}

.sidebar i{
color:white;
font-size:20px;
padding:12px;
border-radius:12px;
cursor:pointer;
transition:0.3s;
}

.sidebar i:hover{
background:#4cc0a3;
}

/* Main */
.main{
flex:1;
padding:20px;
}

.header{
background:#2f6c84;
color:#fff;
padding:15px;
border-radius:10px;
display:flex;
justify-content:space-between;
}

.sub{
font-size:12px;
opacity:0.8;
}

/* Layout */
.dashboard{
display:grid;
grid-template-columns:260px 1fr 300px;
gap:20px;
margin-top:20px;
}

.card{
background:#bcd7e4;
border-radius:20px;
padding:20px;
box-shadow:0 8px 15px rgba(0,0,0,0.2);
}

/* Profile */
.profile{
text-align:center;
}

.profile img{
width:110px;
height:110px;
border-radius:50%;
}

.status{
margin-top:10px;
display:inline-block;
background:#3ddc84;
padding:5px 12px;
border-radius:20px;
font-size:12px;
}

.contact{
margin-top:15px;
font-size:12px;
text-align:left;
}

.menu-item{
background:#e4f1f7;
padding:10px;
border-radius:10px;
margin-top:8px;
display:flex;
justify-content:space-between;
cursor:pointer;
}

.menu-item:hover{
background:#4cc0a3;
color:white;
}

/* Metrics */
.metrics{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
}

.metric{
background:#e4f1f7;
padding:15px;
border-radius:15px;
display:flex;
justify-content:space-between;
align-items:center;
}

.metric i{
font-size:22px;
color:#2f6c84;
}

/* Overview */
.overview{
margin-top:15px;
font-size:12px;
}

/* Chart */
.chart{
margin-top:20px;
height:220px;
display:flex;
align-items:flex-end;
}

.bars{
display:flex;
gap:10px;
height:100%;
align-items:flex-end;
}

.bar{
width:20px;
border-radius:10px;
}

.g{height:40%;background:#3ddc84;}
.y{height:70%;background:#f1c40f;}
.r{height:95%;background:#e74c3c;}

/* Calendar */
.calendar-grid{
display:grid;
grid-template-columns:repeat(7,1fr);
gap:5px;
margin-top:10px;
font-size:12px;
text-align:center;
}

.calendar-grid div{
padding:5px;
border-radius:5px;
}

.active{
background:#4cc0a3;
color:white;
}

/* Alerts */
.alert{
background:#d7c7f0;
padding:10px;
border-radius:10px;
margin-bottom:10px;
display:flex;
justify-content:space-between;
}

/* Buttons */
.button{
background:#f0f0f0;
padding:12px;
border-radius:12px;
margin-top:10px;
display:flex;
justify-content:space-between;
cursor:pointer;
transition:0.3s;
}

.button:hover{
background:#4cc0a3;
color:white;
}